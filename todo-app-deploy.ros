#!/bin/sh
#|-*- mode:lisp -*-|#
#|
exec ros -Q -- $0 "$@"
|#
(progn ;;init forms
  (ros:ensure-asdf)
  (asdf:load-asd (merge-pathnames "todo-app.asd" *load-pathname*))
  #+quicklisp
  (let ((needed '(:sxql :spinneret :cl-inix :consfigurator :postmodern
                  :cl-migratum :cl-migratum.driver.postmodern-postgresql
                  :fiveam :dexador)))
    (unless (every #'ql-dist:find-system (mapcar #'string-downcase needed))
      (ql-dist:install-dist "http://dist.ultralisp.org/" :prompt nil))
    (ql:quickload (list* :todo-app/deploy :todo-app/e2e needed) :silent t)))

(declaim (optimize (speed 3) (safety 1) (debug 1)))

(defpackage :ros.script.todo-app-deploy.3167498364
  (:use :cl :todo-app/deploy :todo-app/e2e)
  (:export #:main))

(in-package :ros.script.todo-app-deploy.3167498364)

(defun main (&rest argv)
  "Entry point for `./todo-app-deploy.ros [e2e]`. Roswell calls this
   automatically after loading the script; it isn't invoked explicitly
   here, so this has to be a function literally named MAIN, taking &REST
   ARGV, per Roswell's own script convention. All of the actual logic
   lives in the :TODO-APP/DEPLOY and :TODO-APP/E2E ASDF systems
   (src/deploy.lisp and t/e2e.lisp); this file only loads them and
   dispatches. With no arguments, deploys the stack via DEPLOY-APP. With
   `e2e`, runs RUN-E2E against whatever's already deployed instead."
  (unless (member "e2e" argv :test #'string=)
    (return-from main (deploy-app)))
  (run-e2e))
;;; vim: set ft=lisp lisp:
